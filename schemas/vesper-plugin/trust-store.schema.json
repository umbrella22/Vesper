{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vesper-player.dev/schemas/plugin/trust-store.schema.json",
  "title": "Vesper Plugin Publisher Trust Store",
  "description": "Host-configured Ed25519 publisher keys. A publisher may retain overlapping active keys during rotation and mark old keys as revoked.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "publishers"],
  "properties": {
    "schema_version": { "const": 1 },
    "publishers": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/reverseDns" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 16,
        "items": { "$ref": "#/$defs/trustedKey" }
      }
    }
  },
  "$defs": {
    "reverseDns": {
      "type": "string",
      "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?\\.[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)*$",
      "maxLength": 255
    },
    "hex32": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trustedKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "public_key", "status"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "key_id": { "$ref": "#/$defs/hex32" },
        "public_key": { "$ref": "#/$defs/hex32" },
        "status": { "enum": ["active", "revoked"] }
      }
    }
  }
}
