#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

run_rust_cli() {
  export VESPER_REPO_ROOT="$REPO_ROOT"

  if [[ -n "${VESPER_CLI:-}" ]]; then
    if [[ ! -x "$VESPER_CLI" ]]; then
      echo "VESPER_CLI is not executable: $VESPER_CLI" >&2
      exit 4
    fi
    if "$VESPER_CLI" "$@"; then
      exit 0
    else
      normalize_rust_cli_status "$?"
    fi
  fi

  if ! command -v cargo >/dev/null 2>&1; then
    echo "The Vesper Rust CLI is not installed and cargo is unavailable." >&2
    exit 4
  fi
  if cargo run --quiet --locked --manifest-path "$REPO_ROOT/Cargo.toml" -p vesper-player-cli -- "$@"; then
    exit 0
  else
    normalize_rust_cli_status "$?"
  fi
}

normalize_rust_cli_status() {
  local status="$1"
  case "$status" in
    2|3|4|5|6)
      exit "$status"
      ;;
  esac
  if (( status == 101 || status >= 128 )); then
    exit 6
  fi
  echo "The Vesper Rust CLI launcher failed with status $status." >&2
  exit 4
}

run_rust_cli "$@"
